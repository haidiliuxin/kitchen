AI_PROVIDER=deepseek

# OpenAI-compatible LLM, used for OCR evidence -> structured recipe and current-step coach.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=180000

# Optional Lanxin / vivo-compatible model gateway.
LANXIN_API_KEY=
LANXIN_APP_KEY=
LANXIN_APP_ID=
LANXIN_BASE_URL=
LANXIN_MODEL=
LANXIN_AUTH_MODE=bearer
LANXIN_JSON_MODE=true
LANXIN_TIMEOUT_MS=180000

# Optional MiniMax Anthropic-compatible model.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=
MINIMAX_ANTHROPIC_VERSION=

# OCR / ASR credentials. Do not put real values in this package.
OCR_PROVIDER=vivo-aigc
VIVO_OCR_APP_KEY=
OCR_VIVO_APP_ID=
OCR_VIVO_APP_KEY=
OCR_VIVO_BUSINESS_ID=
OCR_VIVO_BASE_URL=
OCR_PUBLIC_BASE_URL=

VIVO_AIGC_APP_KEY=
VIVO_ASR_APP_KEY=
VIVO_ASR_DOMAIN=api-ai.vivo.com.cn
VIVO_ASR_ENGINE_ID=shortasrinput
VIVO_ASR_USER_ID=
VIVO_ASR_TIMEOUT_MS=15000
