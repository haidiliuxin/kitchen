# Server only. Copy placeholders into a local .env; never commit real values.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=12000
DEEPSEEK_MAX_OUTPUT_TOKENS=320

DOUBAO_SPEECH_APP_ID=your_doubao_speech_app_id_here
DOUBAO_SPEECH_ACCESS_TOKEN=your_doubao_speech_access_token_here
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=volc.service_type.10029
DOUBAO_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts

VOICE_ASR_SESSION_MAX_MS=20000
VOICE_CONVERSATION_WINDOW_MS=10000
VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787,http://localhost,capacitor://localhost
VOICE_MAX_CONCURRENT_SESSIONS=2
VOICE_SESSION_RATE_PER_MINUTE=6
VOICE_DAILY_ASR_SECONDS=600
VOICE_DAILY_DEEPSEEK_INPUT_TOKENS=50000
VOICE_DAILY_DEEPSEEK_OUTPUT_TOKENS=15000
VOICE_DAILY_TTS_CHARACTERS=5000
VOICE_DAILY_BUDGET_CNY=5
VOICE_ASR_CNY_PER_HOUR=4.5
VOICE_TTS_CNY_PER_10000_CHARS=5
VOICE_DEEPSEEK_INPUT_CNY_PER_MTOKENS=1
VOICE_DEEPSEEK_OUTPUT_CNY_PER_MTOKENS=2

# vivo is retained only for video OCR. These values never feed voice or text AI.
OCR_PROVIDER=vivo-aigc
OCR_PLUGIN_NAME=ocr_image_recognition
OCR_VIVO_APP_ID=your_vivo_ocr_app_id_here
OCR_VIVO_APP_KEY=your_vivo_ocr_app_key_here
OCR_VIVO_BASE_URL=http://api-ai.vivo.com.cn
OCR_VIVO_POS=2
OCR_VIVO_BUSINESS_ID=
OCR_PLUGIN_URL=
OCR_PLUGIN_API_KEY=
OCR_PUBLIC_BASE_URL=

# Existing video/Whisper pipeline.
IMPORT_FETCH_TIMEOUT_MS=15000
VIDEO_TRANSCRIPT_WEBHOOK_URL=http://127.0.0.1:8790/transcribe
YT_DLP_BINARY_PATH=E:\\kitchen-helper\\data\\tools\\yt-dlp.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Client build: the only supported VITE_* setting; it is not secret.
VITE_API_BASE_URL=http://192.168.1.10:8787
