AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=180000

LANXIN_API_KEY=your_lanxin_api_key_here
LANXIN_APP_ID=your_lanxin_app_id_here
LANXIN_AUTH_MODE=gateway
LANXIN_MODEL=xuanji
LANXIN_BASE_URL=https://api-ai.vivo.com.cn/v1
LANXIN_TIMEOUT_MS=180000
LANXIN_JSON_MODE=true

MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_TIMEOUT_MS=180000
MINIMAX_ANTHROPIC_VERSION=2023-06-01

VOICE_WAKE_WORDS=小白下厨,小白教练
IMPORT_FETCH_TIMEOUT_MS=15000
VIDEO_TRANSCRIPT_WEBHOOK_URL=http://127.0.0.1:8790/transcribe
YT_DLP_BINARY_PATH=E:\\kitchen-helper\\data\\tools\\yt-dlp.exe

# Official OCR path for the rescue demo.
# Default provider calls vivo AIGC OCR with Authorization: Bearer <AppKey>.
OCR_PROVIDER=vivo-aigc
OCR_PLUGIN_NAME=ocr_image_recognition
VIVO_AIGC_APP_ID=your_vivo_app_id_here
VIVO_AIGC_APP_KEY=your_vivo_aigc_app_key_here
APP_ID=your_vivo_app_id_here
APP_KEY=your_vivo_aigc_app_key_here
OCR_VIVO_APP_ID=your_vivo_app_id_here
OCR_VIVO_APP_KEY=your_vivo_app_key_here
OCR_VIVO_BASE_URL=http://api-ai.vivo.com.cn
OCR_VIVO_POS=2
OCR_VIVO_BUSINESS_ID=

# Optional URL-mode adapter. Use this only if the contest platform gives
# an HTTP endpoint that accepts { "url": "https://..." }.
OCR_PLUGIN_URL=
OCR_PLUGIN_API_KEY=

# Required only when URL-mode OCR runs in the cloud and cannot access localhost.
OCR_PUBLIC_BASE_URL=

VIVO_ASR_APP_KEY=your_vivo_aigc_app_key_here
VIVO_ASR_DOMAIN=api-ai.vivo.com.cn
VIVO_ASR_ENGINE_ID=shortasrinput
VIVO_ASR_TIMEOUT_MS=15000
VIVO_ASR_USER_ID=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
